# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID from the Discord developer portal
CLIENT_ID=

# Optional: restrict command registration to one guild during development.
# Leave empty to register commands globally (takes up to 1 hour to propagate).
GUILD_ID=

# Comma-separated role IDs whose members may use the bot (in addition to Administrators).
# Leave empty if only server Administrators should have access.
# Example: ADMIN_ROLE_IDS=123456789012345678,987654321098765432
ADMIN_ROLE_IDS=

# ── AI (OpenAI-compatible endpoint) ──────────────────────────────────────────
# API key for the AI endpoint. Works with OpenAI, Cursor AI proxy, or any
# OpenAI-compatible provider that supports function calling (tools).
AI_API_KEY=

# Base URL of the OpenAI-compatible API.
# OpenAI: https://api.openai.com/v1
# Cursor proxy: set to the proxy URL provided in the Cursor developer settings
AI_BASE_URL=https://api.openai.com/v1

# Model to use for planning. Must support function calling / tools.
# Recommended: gpt-4o, gpt-4.1, gpt-4.1-mini, o4-mini
AI_MODEL=gpt-4o
